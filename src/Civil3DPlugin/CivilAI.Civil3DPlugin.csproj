<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Civil 3D 2027 plugin (D1), roadmap 0.3.

    Two build modes:
    - On a Windows PC with Civil 3D 2027 installed: Autodesk references are found in
      $(AutoCADDir) (default C:\Program Files\Autodesk\AutoCAD 2027), the Civil3D/ code is
      compiled, and the output folder gets a ready-to-copy CivilAI.bundle.
      Override the folder with -p:AutoCADDir="D:\...\AutoCAD 2027".
      Add -p:InstallBundle=true to also copy the bundle to %APPDATA%\Autodesk\ApplicationPlugins.
    - Anywhere else (Linux, CI): no Autodesk DLLs, so only the Autodesk-free shell compiles.
      CI stays green; the real plugin is verified by the owner in Civil 3D.

    Target framework: .NET 8 per D1. If Civil 3D 2027 turns out to need a newer runtime,
    build with -p:Civil3DTargetFramework=net10.0-windows (needs that SDK).
  -->
  <PropertyGroup>
    <Civil3DTargetFramework Condition="'$(Civil3DTargetFramework)' == ''">net8.0-windows</Civil3DTargetFramework>
    <TargetFramework>$(Civil3DTargetFramework)</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CivilAI.Civil3DPlugin</RootNamespace>
    <AssemblyName>CivilAI.Civil3DPlugin</AssemblyName>
    <Version>0.3.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">$(ProgramW6432)\Autodesk\AutoCAD 2027</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == '\Autodesk\AutoCAD 2027'">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADDir>
    <HasAutoCAD Condition="Exists('$(AutoCADDir)\acmgd.dll')">true</HasAutoCAD>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CivilAI.Core.csproj" />
  </ItemGroup>

  <!-- Without Civil 3D: compile only the Autodesk-free shell. -->
  <ItemGroup Condition="'$(HasAutoCAD)' != 'true'">
    <Compile Remove="Civil3D\**" />
  </ItemGroup>

  <!-- With Civil 3D 2027 installed: the real plugin. -->
  <PropertyGroup Condition="'$(HasAutoCAD)' == 'true'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);CIVIL3D</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasAutoCAD)' == 'true'">
    <Reference Include="accoremgd"><HintPath>$(AutoCADDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AutoCADDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AutoCADDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AutoCADDir)\AdWindows.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(AutoCADDir)\C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd" Condition="Exists('$(AutoCADDir)\ACA\AecBaseMgd.dll')"><HintPath>$(AutoCADDir)\ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Autoloader bundle: <OutDir>\CivilAI.bundle\PackageContents.xml + Contents\*.dll.
    Civil 3D loads it from %APPDATA%\Autodesk\ApplicationPlugins at startup.
  -->
  <Target Name="MakeBundle" AfterTargets="Build" Condition="'$(HasAutoCAD)' == 'true'">
    <PropertyGroup>
      <BundleDir>$(OutDir)CivilAI.bundle\</BundleDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleDll Include="$(OutDir)*.dll" />
      <BundleDll Include="$(OutDir)*.pdb" />
      <BundleDll Include="$(OutDir)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="Bundle\PackageContents.xml" DestinationFolder="$(BundleDir)" />
    <Copy SourceFiles="@(BundleDll)" DestinationFolder="$(BundleDir)Contents\" />
    <Message Importance="high" Text="CivilAI bundle: $(BundleDir)" />
  </Target>

  <Target Name="InstallBundle" AfterTargets="MakeBundle" Condition="'$(HasAutoCAD)' == 'true' And '$(InstallBundle)' == 'true'">
    <PropertyGroup>
      <InstallDir>$(APPDATA)\Autodesk\ApplicationPlugins\CivilAI.bundle\</InstallDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleFile Include="$(OutDir)CivilAI.bundle\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFile)" DestinationFiles="@(BundleFile->'$(InstallDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="CivilAI bundle installed to $(InstallDir) (restart Civil 3D)" />
  </Target>

</Project>
