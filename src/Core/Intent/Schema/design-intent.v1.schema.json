{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OT-LAND/civil3d-ai-designer/design-intent.v1.schema.json",
  "title": "Design Intent v1",
  "description": "A landscape design described as spaces, levels, edges, materials, trees, drainage and site elements. Units: metres, drawing coordinates (X east, Y north, Z absolute level). Polygons are closed implicitly: do not repeat the first point. Ids are unique across the document. zoneId, interestPointId and flowBasinId refer to the Design Brief.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "site",
    "spaces",
    "edges",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0",
        "1"
      ],
      "description": "\"1\" for new documents. \"0\" documents must not use trees, drainage or elements."
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "trees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tree"
      }
    },
    "drainage": {
      "$ref": "#/$defs/drainage"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "polygon": {
      "description": "Closed polygon; the first point is not repeated at the end.",
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "polyline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildings"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "lotBoundary": {
          "$ref": "#/$defs/polygon"
        },
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/building"
          }
        }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "footprint",
        "ffl",
        "entrances"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "footprint": {
          "$ref": "#/$defs/polygon"
        },
        "ffl": {
          "type": "number",
          "description": "Finished floor level, absolute, metres."
        },
        "entrances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entrance"
          }
        }
      }
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "location",
        "accessible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/point"
        },
        "thresholdLevel": {
          "type": "number",
          "description": "Omit to use the building FFL."
        },
        "accessible": {
          "type": "boolean",
          "description": "Must be reached by a step-free route."
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "plaza",
            "path",
            "lawn",
            "bed"
          ]
        },
        "name": {
          "type": "string"
        },
        "outline": {
          "$ref": "#/$defs/polygon",
          "description": "Plaza, lawn and bed only."
        },
        "centerline": {
          "$ref": "#/$defs/polyline",
          "description": "Path only, start to end."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Path only, metres."
        },
        "accessible": {
          "type": "boolean",
          "description": "Path only. Omit for an accessible route (the default); false only when the designer says this path is not part of the accessible route."
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "materialId": {
          "type": "string"
        },
        "zoneId": {
          "type": "string",
          "description": "Design Brief zone this space was planned in."
        },
        "interestPointId": {
          "type": "string",
          "description": "Design Brief interest point this space is the place for."
        }
      }
    },
    "level": {
      "description": "How the space sits in height. Omit parts the designer has not fixed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spots"
      ],
      "properties": {
        "elevation": {
          "type": "number",
          "description": "Nominal level, absolute, metres."
        },
        "spots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spotLevel"
          }
        },
        "fall": {
          "$ref": "#/$defs/fall"
        }
      }
    },
    "spotLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "fall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "directionDegrees"
      ],
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "directionDegrees": {
          "type": "number",
          "description": "Direction the surface falls towards, degrees counter-clockwise from east."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "line",
        "spaceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "flush",
            "kerb",
            "steps",
            "wall"
          ]
        },
        "line": {
          "$ref": "#/$defs/polyline"
        },
        "spaceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "description": "Kerb upstand, total step rise or wall retained height, metres. Required for steps and wall."
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "paving",
            "gravel",
            "lawn",
            "planting",
            "mulch",
            "other"
          ]
        },
        "costClass": {
          "$ref": "#/$defs/costClass"
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "location",
        "canopyDiameter"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "new",
            "existing"
          ],
          "description": "new = planted by the design; existing = surveyed tree that is kept."
        },
        "location": {
          "$ref": "#/$defs/point"
        },
        "species": {
          "type": "string"
        },
        "canopyDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Metres; at maturity for new trees, as surveyed for existing ones."
        },
        "trunkDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Metres, at 1.3 m."
        },
        "protectionRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Existing trees only: root protection radius, metres."
        },
        "sourceId": {
          "type": "string",
          "description": "Survey tree id (required for existing trees) or brief tree point id."
        },
        "zoneId": {
          "type": "string"
        },
        "costClass": {
          "$ref": "#/$defs/costClass",
          "description": "New trees only: size at planting (low = small stock, high = semi-mature)."
        }
      }
    },
    "drainage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "swales",
        "basins",
        "lowPoints"
      ],
      "properties": {
        "swales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/swale"
          }
        },
        "basins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basin"
          }
        },
        "lowPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lowPoint"
          }
        }
      }
    },
    "swale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "line"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/polyline",
          "description": "Flow line, high end first."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Top width, metres."
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Metres."
        },
        "flowBasinId": {
          "type": "string",
          "description": "Design Brief flow-basin curve."
        },
        "outletId": {
          "type": "string",
          "description": "Id of the basin or low point it drains into."
        }
      }
    },
    "basin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "outline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "retention",
            "infiltration"
          ]
        },
        "outline": {
          "$ref": "#/$defs/polygon"
        },
        "bottomLevel": {
          "type": "number",
          "description": "Absolute, metres."
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Below the rim, metres."
        },
        "flowBasinId": {
          "type": "string",
          "description": "Design Brief flow-basin curve."
        }
      }
    },
    "lowPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "location",
        "inlet"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/point"
        },
        "level": {
          "type": "number",
          "description": "Absolute, metres. Omit to let grading set it."
        },
        "inlet": {
          "type": "boolean",
          "description": "true = drain/inlet into pipes; false = surface low point."
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "seating",
            "lighting",
            "play",
            "shade",
            "pergola",
            "water",
            "art",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/point"
        },
        "outline": {
          "$ref": "#/$defs/polygon",
          "description": "Footprint. Required for shade and pergola."
        },
        "rotationDegrees": {
          "type": "number",
          "description": "Counter-clockwise from east."
        },
        "zoneId": {
          "type": "string"
        },
        "interestPointId": {
          "type": "string"
        },
        "costClass": {
          "$ref": "#/$defs/costClass"
        }
      }
    },
    "costClass": {
      "enum": [
        "low",
        "mid",
        "high"
      ],
      "description": "Cost level relative to alternatives for the same job (D20): low = economical (gravel, small stock), high = premium (natural stone, semi-mature trees)."
    }
  }
}
