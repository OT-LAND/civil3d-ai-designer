<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core: Civil 3D-independent logic (geometry, grading math, rule checks, Design Intent,
    Claude client). No Autodesk references, so it builds and tests on Linux / in CI.
    net8.0 matches Civil 3D 2025+. If D1 adds Civil 3D 2024 or older (.NET Framework 4.8),
    retarget to netstandard2.0 (Slope.cs is already written to compile there).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CivilAI.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Design Intent JSON Schema; read with DesignIntentJson.ReadSchema(). -->
    <EmbeddedResource Include="Intent\Schema\design-intent.v0.schema.json" LogicalName="CivilAI.Core.Intent.Schema.design-intent.v0.schema.json" />
    <!-- System prompt for free text → Design Intent (1.2); read with TextToIntent.ReadSystemPrompt(). -->
    <EmbeddedResource Include="Intent\Prompts\text-to-intent.v0.md" LogicalName="CivilAI.Core.Intent.Prompts.text-to-intent.v0.md" />
    <!-- Default starter design-rule set (2.2, D3); read with RuleSetJson.LoadDefault(). -->
    <EmbeddedResource Include="Rules\RuleSets\default-il.v0.json" LogicalName="CivilAI.Core.Rules.RuleSets.default-il.v0.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- .xlsx tree tables (2.1c, D12). MIT licence, no further dependencies. -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
  </ItemGroup>

</Project>
